Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"ph", "[", "x_", "]"}], "=", 
  RowBox[{"Together", "[", 
   RowBox[{"ExpandAll", "[", 
    RowBox[{
     RowBox[{"x", "^", "2"}], "*", 
     RowBox[{
      RowBox[{"p", "[", "x", "]"}], "/", 
      RowBox[{"q", "[", "x", "]"}]}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{4.002425357305277*^9, 4.002425397438802*^9}, {
  4.002425513323675*^9, 4.002425532108058*^9}},
 CellLabel->
  "In[190]:=",ExpressionUUID->"08ed54cb-4880-4f90-bb1f-dce1c3b6f3a9"],

Cell[BoxData[
 FractionBox[
  RowBox[{"0.9999999999999988`", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"0.24999999999999978`", " ", 
      SuperscriptBox["x", "4"]}], "+", 
     SuperscriptBox["x", "8"]}], ")"}]}], 
  RowBox[{
   RowBox[{"-", "1.`"}], "-", 
   RowBox[{"5.`", " ", 
    SuperscriptBox["x", "2"]}], "+", 
   RowBox[{"5.`", " ", 
    SuperscriptBox["x", "4"]}], "+", 
   SuperscriptBox["x", "6"]}]]], "Output",
 CellChangeTimes->{4.0024254043514433`*^9, 4.00242546871148*^9, 
  4.0024255349884853`*^9, 4.0024256293522167`*^9},
 CellLabel->
  "Out[190]=",ExpressionUUID->"89ffe94c-7d36-4591-81dc-b607af5f917f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"w", "=", 
  RowBox[{"x", "/.", 
   RowBox[{"NSolve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ph", "[", "x", "]"}], "==", "0"}], ",", "x"}], 
    "]"}]}]}]], "Input",
