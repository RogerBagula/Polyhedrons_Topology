   4.00221864997208*^9}, 4.002219211320828*^9, 4.002344628207781*^9, 
   4.002429372833127*^9, {4.002442275769953*^9, 4.002442292520208*^9}, {
   4.002448174748605*^9, 4.002448181658774*^9}, 4.002458912798881*^9, 
   4.0025460603966627`*^9, 4.0025683780265417`*^9, 4.002623965004107*^9},
 AspectRatioFixed->True,
 FontSize->14,
 CellLabel->"In[15]:=",ExpressionUUID->"a7c77792-5ffc-4f58-8275-0c8de207a996"],

Cell["\<\
FractalPureM[{{ReMin_, ReMax_, ReSteps_},
\t\t\t {ImMin_, ImMax_, ImSteps_}}] :=
\t\tParallelTable[
\t\t\tnumberOfz2ToEscape[x + y I],
\t\t\t{y, ImMin, ImMax, (ImMax - ImMin)/ImSteps},
\t\t\t{x, ReMin, ReMax, (ReMax - ReMin)/ReSteps}
\t\t
\t]
\t\
\>", "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9772923710972137`*^9, 3.977292374785019*^9}},
 AspectRatioFixed->True,
 FontSize->14,
 CellLabel->"In[19]:=",ExpressionUUID->"d1a4613a-8dd3-48ed-a7fc-7e5ac4e04671"],

