Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"https", ":"}], "//", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"mathematica", ".", "stackexchange", ".", "com"}], "/", 
        "questions"}], "/", "287716"}], "/", "how"}], "-", "plot", "-", "the",
      "-", 
     RowBox[{"3", "d"}], "-", "cayley", "-", "graph", "-", "of", "-", "f", 
     "-", "3"}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"by", " ", "Ghoster"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"f3", "[", "maxWordLength_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "e", ",", "a", ",", "b", ",", "c", ",", "s", ",", "t", ",", 
        "edgeLengths", ",", "newEdges", ",", "grow", ",", "renderEdge", ",", 
        "show", ",", "initialEdges", ",", "graph"}], "}"}], ",", 
      RowBox[{
       RowBox[{"e", "=", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"a", "=", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"b", "=", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"c", "=", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"s", "=", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c"}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"t", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"s", ",", 
          RowBox[{"-", "s"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"edgeLengths", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"3", "/", 
           RowBox[{"2", "^", 
            RowBox[{"(", 
             RowBox[{"n", "+", "1"}], ")"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "1", ",", "maxWordLength"}], "}"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"newEdges", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"p1_", ",", "p2_"}], "}"}], ",", "len_"}], "]"}], ":=", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"new", ",", "back"}], "}"}], ",", 
          RowBox[{
           RowBox[{"new", "=", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{"p2", ",", 
                 RowBox[{"p2", "+", 
                  RowBox[{"len", " ", "#"}]}]}], "}"}], "&"}], ",", "t"}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"back", "=", 
            RowBox[{"{", 
             RowBox[{"p2", ",", 
              RowBox[{"p2", "+", 
               RowBox[{"len", " ", 
                RowBox[{"Normalize", "[", 
                 RowBox[{"p1", "-", "p2"}], "]"}]}]}]}], "}"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"DeleteCases", "[", 
            RowBox[{"new", ",", "back"}], "]"}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"grow", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"allEdges_", ",", "latestEdges_"}], "}"}], ",", "level_"}],
          "]"}], ":=", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", "new", "}"}], ",", 
          RowBox[{
           RowBox[{"new", "=", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"newEdges", "[", 
                RowBox[{"#", ",", 
                 RowBox[{"edgeLengths", "[", 
                  RowBox[{"[", "level", "]"}], "]"}]}], "]"}], "&"}], ",", 
              "latestEdges"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"new", "=", 
            RowBox[{"Flatten", "[", 
             RowBox[{"new", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Join", "[", 
              RowBox[{"allEdges", ",", "new"}], "]"}], ",", "new"}], 
            "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"renderEdge", "[", 
         RowBox[{"{", 
          RowBox[{"p1_", ",", "p2_"}], "}"}], "]"}], ":=", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", "level", "}"}], ",", 
          RowBox[{
           RowBox[{"level", "=", 
            RowBox[{
             RowBox[{"Position", "[", 
              RowBox[{"edgeLengths", ",", 
               RowBox[{"EuclideanDistance", "[", 
                RowBox[{"p1", ",", "p2"}], "]"}]}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Cube", "[", 
              RowBox[{"p1", ",", 
               RowBox[{"1", "/", 
                RowBox[{"2", "^", 
                 RowBox[{"(", 
                  RowBox[{"level", "-", "1"}], ")"}]}]}]}], "]"}], ",", 
             RowBox[{"Cube", "[", 
              RowBox[{"p2", ",", 
               RowBox[{"1", "/", 
                RowBox[{"2", "^", "level"}]}]}], "]"}]}], "}"}]}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"show", "[", "graph_", "]"}], ":=", 
        RowBox[{"Graphics3D", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Red", ",", 
            RowBox[{"Map", "[", 
             RowBox[{"renderEdge", ",", 
              RowBox[{"First", "[", "graph", "]"}]}], "]"}]}], "}"}], ",", 
          RowBox[{"ImageSize", "->", 
           RowBox[{"{", 
            RowBox[{"2000", ",", "2000"}], "}"}]}], ",", 
          RowBox[{"ViewPoint", "->", 
           RowBox[{"{", 
            RowBox[{"2", ",", "2", ",", "2"}], "}"}]}], ",", 
          RowBox[{"Background", "->", "Black"}], ",", 
          RowBox[{"Boxed", "->", "False"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"initialEdges", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"edgeLengths", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", 
            RowBox[{"{", 
             RowBox[{"e", ",", "#"}], "}"}]}], "&"}], ",", "t"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"graph", "=", 
        RowBox[{"{", 
         RowBox[{"initialEdges", ",", "initialEdges"}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"graph", "=", 
          RowBox[{"grow", "[", 
           RowBox[{"graph", ",", "n"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "2", ",", "maxWordLength"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"show", "[", "graph", "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"and", " ", "then", " ", "execute"}], "*)"}], "\n", 
